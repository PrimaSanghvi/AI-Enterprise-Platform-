# Anthropic API key (required for AI chat and triage)
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/your_db_name
DB_SCHEMA=ai_platform_db

# Backend MCP server URL (gateway connects to this)
MCP_SERVER_URL=http://localhost:8000/mcp

# CORS origins (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Login module (Google sign-in) ---
# Google OAuth Client ID (Web application). Same value goes in both vars:
#   - GOOGLE_CLIENT_ID is used by the gateway to verify ID tokens
#   - VITE_GOOGLE_CLIENT_ID is used by the frontend to render the Google button
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Secret used to sign session tokens (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string
# Hours a user may access the system from their first login
ACCESS_WINDOW_HOURS=2
