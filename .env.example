# Anthropic API key (required for AI chat and triage)
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/your_db_name
DB_SCHEMA=ai_platform_db

# Backend MCP server URL (gateway connects to this)
MCP_SERVER_URL=http://localhost:8000/mcp

# CORS origins (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Login module ---
# Google OAuth Client ID (Web application). Leave blank to hide the Google button
# and show email+OTP as the only login option.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Secret used to sign session tokens (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string
# Hours a user may access the system from their first login
ACCESS_WINDOW_HOURS=2

# --- Email OTP (Gmail SMTP) ---
# SMTP host/port are set here for local dev; in Docker they are baked into the
# Dockerfile so only the credentials need to be injected as secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmail address used to authenticate (must match the App Password below).
# Emails are NOT sent from this address — it is only used, together with
# SMTP_PASS, as the login credential pair. See SMTP_FROM for the sender.
SMTP_USER=you@gmail.com
# Gmail App Password (16-char, generated at myaccount.google.com/apppasswords)
# Requires 2-Step Verification to be enabled on the account.
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# Address shown to recipients as the sender, e.g. a no-reply address
# (falls back to SMTP_USER if left blank).
SMTP_FROM=no-reply@yourdomain.com

# --- Service-to-service / hardening ---
# Shared secret the gateway presents to the protected /mcp mount (generate a long
# random string). Required; the in-process MCP client uses it.
MCP_INTERNAL_TOKEN=change-me-to-a-long-random-string
# Emails (comma-separated) granted the Platform Admin role on first login, so the
# first admin can manage policy rules without manual SQL.
BOOTSTRAP_ADMIN_EMAILS=
# Role allowed to mutate policy rules (defaults to "Platform Admin")
POLICY_ADMIN_ROLE=Platform Admin
# Per-user agent rate limit: max requests per window (seconds)
AGENT_RATE_LIMIT=20
AGENT_RATE_WINDOW=60
