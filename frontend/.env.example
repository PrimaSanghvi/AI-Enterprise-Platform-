# NOTE: Vite now loads env from the repo-root .env (see vite.config.ts `envDir`),
# so set these in ../.env alongside the backend vars — not here.
#
# Gateway API URL (the frontend talks to this)
VITE_API_BASE=http://localhost:8000
# Google OAuth Client ID for the "Sign in with Google" button
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
